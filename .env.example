OPENAI_API_KEY=

VOICE_BOT_BACKEND=responses

OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_CONNECTIVITY_HOST=api.openai.com
OPENAI_CONNECTIVITY_WAIT_SECONDS=120
OPENAI_TIMEOUT_SECONDS=120
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar
TTS_INSTRUCTIONS="Speak naturally. Match the user's language. Keep the response clear and comfortable to listen to."

REALTIME_MODEL=gpt-realtime-2
REALTIME_REASONING_EFFORT=medium
REALTIME_VOICE=marin
REALTIME_INPUT_RATE=24000
REALTIME_INPUT_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_RESPONSE_TIMEOUT_SECONDS=90
REALTIME_IDLE_TIMEOUT_SECONDS=45
REALTIME_MAX_SESSION_SECONDS=300
REALTIME_SILENT_COOLDOWN_SECONDS=5
REALTIME_HISTORY_MESSAGES=16
REALTIME_SAFETY_IDENTIFIER=voice-ai-bot-local

USER_CITY=Cambridge
USER_REGION=Cambridgeshire
USER_COUNTRY=GB
USER_TIMEZONE=Europe/London

OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT_SECONDS=10
WEATHER_CACHE_SECONDS=600

WEB_SEARCH_MODEL=gpt-5.5
WEB_SEARCH_REASONING_EFFORT=high
WEB_SEARCH_CONTEXT_SIZE=medium
WEB_SEARCH_TIMEOUT_SECONDS=90
TASK_MODEL=gpt-5.5
TASK_REASONING_EFFORT=high
TASK_REASONING_SUMMARY=auto
TASK_TIMEOUT_SECONDS=180
TASK_CODE_EXECUTION=true
MAX_BACKGROUND_TASKS=20
TASK_RESULT_CHARS=12000
TASK_SUMMARY_CHARS=4000

BUTTON_GPIO=23
LED_GPIO=25
BUTTON_PULL_UP=true
SHORT_CLICK_SECONDS=0.45
DOUBLE_CLICK_WINDOW_SECONDS=0.65

AUDIO_CAPTURE_DEVICE=plughw:1,0
AUDIO_PLAYBACK_DEVICE=plughw:1,0
VOICE_VOLUME=10
RECORD_RATE=16000
RECORD_CHANNELS=1
MIN_RECORD_SECONDS=0.25

CONVERSATION_FILE=/var/lib/voice-ai-bot/conversation.json
SCHEDULED_TASKS_FILE=/var/lib/voice-ai-bot/scheduled_tasks.json
SCHEDULE_QUIET_START=21:00
SCHEDULE_QUIET_END=07:30
RECORDINGS_DIR=/var/lib/voice-ai-bot/recordings
TTS_CHUNK_CHARS=240
MEMORY_DIR=/var/lib/voice-ai-bot/agent
MEMORY_BOOTSTRAP_CHARS=12000
MEMORY_ACTIVE_CONTEXT_CHARS=1800
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_MODEL=gpt-5.5
MEMORY_CONSOLIDATION_REASONING_EFFORT=high
MEMORY_CONSOLIDATION_DEBOUNCE_SECONDS=5
MEMORY_CONSOLIDATION_SHUTDOWN_TIMEOUT_SECONDS=30
MEMORY_CONSOLIDATION_MAX_NOTES=12
MEMORY_CONSOLIDATION_MAX_CHARS=16000
LOG_LEVEL=INFO
