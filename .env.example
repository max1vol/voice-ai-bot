OPENAI_API_KEY=

OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar
TTS_INSTRUCTIONS="Speak naturally. Match the user's language. Keep the response clear and comfortable to listen to."

BUTTON_GPIO=23
LED_GPIO=25
BUTTON_PULL_UP=true
SHORT_CLICK_SECONDS=0.45
DOUBLE_CLICK_WINDOW_SECONDS=0.65

AUDIO_CAPTURE_DEVICE=plughw:1,0
AUDIO_PLAYBACK_DEVICE=plughw:1,0
RECORD_RATE=16000
RECORD_CHANNELS=1
MIN_RECORD_SECONDS=0.25

CONVERSATION_FILE=/var/lib/voice-ai-bot/conversation.json
RECORDINGS_DIR=/var/lib/voice-ai-bot/recordings
TTS_CHUNK_CHARS=240
LOG_LEVEL=INFO
