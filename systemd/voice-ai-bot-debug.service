[Unit]
Description=Voice AI Bot Debug Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/voice-ai-bot
EnvironmentFile=/opt/voice-ai-bot/.env
ExecStart=/opt/voice-ai-bot/.venv/bin/voice-ai-bot-debug-web
Restart=always
RestartSec=3
RuntimeDirectory=voice-ai-bot-debug
StateDirectory=voice-ai-bot
SupplementaryGroups=audio gpio i2c spi input video
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
