[Unit]
Description=Voice AI Bot
After=sound.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/voice-ai-bot
EnvironmentFile=/opt/voice-ai-bot/.env
ExecStart=/opt/voice-ai-bot/.venv/bin/voice-ai-bot
Restart=always
RestartSec=3
RuntimeDirectory=voice-ai-bot
StateDirectory=voice-ai-bot
SupplementaryGroups=audio gpio i2c spi input video

[Install]
WantedBy=multi-user.target
